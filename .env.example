# ============================================================
#  CORA Copilot — BIS Engine AI Integration
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to git.
# ============================================================

# --- OpenAI / GPT-OSS 120B Configuration ---
# Replace with your actual API key from your provider dashboard
VITE_OPENAI_API_KEY=your_api_key_here

# Base URL for the OpenAI-compatible API endpoint
# Default: https://api.openai.com/v1
# For custom deployments, replace with your endpoint
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier — use gpt-oss-120b for GPT OSS 120B
VITE_OPENAI_MODEL=gpt-oss-120b

# ---- Streaming & Performance ----
# Enable streaming responses (true/false)
VITE_AI_STREAM=true
# Max tokens per response
VITE_AI_MAX_TOKENS=1024
# Temperature: 0.0 (deterministic) to 1.0 (creative). 0.3 recommended for procurement.
VITE_AI_TEMPERATURE=0.3

# ---- App Identity ----
VITE_APP_NAME=BIS Engine
VITE_APP_VERSION=1.0.0
VITE_CORA_NAME=CORA

# ---- Feature Flags ----
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_CHAT_HISTORY=true
